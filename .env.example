# Copy to .env (development) or export in the deployment environment.
ORCH_API_KEY=change-me
ORCH_ADMIN_API_KEY=change-me-too
ORCH_SECRET_KEY=change-me-as-well
# ORCH_WEBUI_SECRET_KEY=            # Open WebUI WEBUI_SECRET_KEY, for auth_type=session
ORCH_SANDBOX_ACCESS=published       # development on the host; use "network" in a container
ORCH_DEFAULT_IMAGE=ghcr.io/open-webui/open-terminal:slim
# ORCH_IMAGE_ALLOWLIST=ghcr.io/open-webui/open-terminal*
# ORCH_PULL_POLICY=if-not-present
# ORCH_AIRGAPPED=false
