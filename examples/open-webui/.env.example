# Generate the secrets with:
#   for v in WEBUI_SECRET_KEY ORCH_API_KEY ORCH_ADMIN_API_KEY ORCH_SECRET_KEY; do echo "$v=$(openssl rand -hex 32)"; done > .env
WEBUI_SECRET_KEY=
ORCH_API_KEY=
ORCH_ADMIN_API_KEY=
ORCH_SECRET_KEY=

# Optional: any OpenAI-compatible provider (can also be added later in the UI).
# OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=

# Optional overrides.
# OPEN_WEBUI_PORT=3000
# SANDBOX_IMAGE=ghcr.io/felix920506/open-terminal-scientific:latest   # scientific, images, Excel, PDF, Word, PowerPoint
# MAX_RUNNING_SANDBOXES=20
# STAGE_UPLOADS=true   # attach files before a chat's first message (needs the Terminal uploads filter)
